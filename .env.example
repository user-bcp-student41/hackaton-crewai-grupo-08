# S1 CrewAI — lee el backlog vía MCP Proyectos. Solo abre PR si activas CREWAI_PUBLISH_PRS.

# ── LLM — GitHub Copilot ────────────────────────────────────────────
COPILOT_MODEL=gpt-6-luna
COPILOT_REASONING_EFFORT=high
# true usa la sesión guardada del CLI; false exige un token explícito.
COPILOT_USE_LOGGED_IN_USER=true

# Copiar este archivo como .env. NUNCA commitear .env.

# ── MCP Proyectos — backlog de GitHub Projects (puerto 8081) ─────
PROJECTS_MCP_URL=http://localhost:8081
PROJECTS_MCP_API_KEY=prj-xxxxxxxxxxxxxxxxxxxx

# Owner, repo y proyecto del backlog del equipo.
GITHUB_OWNER=user-bcp-student41
GITHUB_REPO=hackaton-grupo-08
GITHUB_PROJECT_TITLE=backlog-hackaton-grupo-08

# Solo el grupo de siete activa Datos y persistencia.
CREWAI_INCLUDE_DATA=false

# Flujo de desarrollo: el PR se abre en el repo clonado solo tras la aprobación final.
FEATURE_REPO=user-bcp-student41/hackaton-grupo-08
FEATURE_BASE_BRANCH=main

# Flujo del PO: plan del que se leen las historias (relativo a este repo o ruta absoluta).
PO_PLAN_FILE=plan-inicial-epica-hus.md

# Compatibilidad con el flujo anterior (legacy).
CREWAI_PUBLISH_PRS=false
AI_LABS_REPO=<OWNER>/ai-labs
